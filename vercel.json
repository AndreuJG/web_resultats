{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/eurolliga.html",
      "destination": "/api/eurolliga"
    },
    {
      "source": "/eurocup.html",
      "destination": "/api/eurocup"
    },
    {
      "source": "/acb.html",
      "destination": "/api/acb"
    }
  ]
}
